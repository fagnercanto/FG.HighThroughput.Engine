@page "/"
@using FG.HighThroughput.Engine.Core
@using FG.HighThroughput.Engine.Infrastructure
@implements IDisposable
@inject TestDataFileGenerator TestDataFileGenerator
@inject IIngestionDataReader IngestionDataReader
@inject IServiceProvider ServiceProvider
@inject IWebHostEnvironment Environment
@inject ILogger<Home> Logger
@rendermode InteractiveServer

<PageTitle>High Throughput Engine</PageTitle>

<div class="row g-4 mb-4">
<div class="col-lg-4">
<div class="card h-100">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>1. Gerar massa de teste</span>
        @if (IsGenerating)
        {
            <span class="badge text-bg-warning">Gerando...</span>
        }
        else if (ElapsedTime is not null)
        {
            <span class="badge text-bg-success">Concluído</span>
        }
    </div>
    <div class="card-body">
        <p>
            Gere uma massa de dados de teste para alimentar o stress test de ingestão. O arquivo é
            salvo em <code>App_Data/ingestion-sample.txt</code> (formato simples) ou
            <code>App_Data/ingestion-sample-sped.txt</code> (formato SPED completo).
        </p>
        <div class="mb-3">
            <label class="form-label d-block">Formato</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="formatSimple" name="format"
                       checked="@(SelectedFormat == RecordFormat.Simple)"
                       disabled="@(IsGenerating || IsIngesting)"
                       @onchange="@(() => SelectFormat(RecordFormat.Simple))" />
                <label class="form-check-label" for="formatSimple">Simples (Id|RawValue)</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="formatSped" name="format"
                       checked="@(SelectedFormat == RecordFormat.SpedCompleto)"
                       disabled="@(IsGenerating || IsIngesting)"
                       @onchange="@(() => SelectFormat(RecordFormat.SpedCompleto))" />
                <label class="form-check-label" for="formatSped">SPED completo (0000/I200/I250/9999)</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Prévia do formato (primeiras @PreviewLines.Count linhas)</label>
            <pre class="border rounded p-2 bg-light" style="max-height: 140px; overflow: auto; font-size: 0.8rem;"><code>@string.Join(System.Environment.NewLine, PreviewLines)</code></pre>
        </div>

        <div class="mb-3">
            <label for="recordCount" class="form-label">Quantidade de registros</label>
            <input id="recordCount" class="form-control" style="max-width: 260px;"
                   type="text" inputmode="numeric" value="@RecordCount.ToString("N0")"
                   @onchange="OnRecordCountChanged" disabled="@IsGenerating" />
        </div>

        <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@IsGenerating">
            @if (IsGenerating)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @(IsGenerating ? "Gerando..." : "Gerar massa de teste")
        </button>

        @if (IsGenerating)
        {
            <div class="mt-3">
                <progress value="@GeneratedCount" max="@RecordCount" style="width: 100%;"></progress>
                <p>@GeneratedCount.ToString("N0") / @RecordCount.ToString("N0") registros gerados</p>
                <p class="text-muted">Tempo decorrido: @FormatElapsed(GenerationStopwatch)</p>
            </div>
        }

        @if (!IsGenerating && ElapsedTime is not null)
        {
            <p class="text-success mt-3">
                Arquivo gerado com sucesso em @ElapsedTime.Value.TotalSeconds.ToString("N1")s: <code>@FilePath</code>
                <a class="btn btn-outline-primary btn-sm ms-2" href="@DownloadUrl" title="Baixar arquivo para o seu computador">
                    ⬇️ Baixar arquivo
                </a>
                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="OpenFileFolder" title="Abrir pasta do arquivo no servidor">
                    📂 Abrir pasta (servidor)
                </button>
            </p>
        }

        @if (ErrorMessage is not null)
        {
            <p class="text-danger mt-3">@ErrorMessage</p>
        }
    </div>
</div>
</div>

<div class="col-lg-4">
<div class="card h-100">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>2. Disparar ingestão</span>
        @if (IsIngesting)
        {
            <span class="badge text-bg-warning">Ingerindo...</span>
        }
        else if (IngestionElapsedTime is not null)
        {
            <span class="badge text-bg-success">Concluído</span>
        }
    </div>
    <div class="card-body">
        <p>
            Executa o produtor (leitura do arquivo) e o consumidor (bulk insert) em paralelo,
            usando o arquivo gerado acima.
        </p>

        <button class="btn btn-success" @onclick="IngestAsync" disabled="@(IsIngesting || !File.Exists(FilePath))">
            @if (IsIngesting)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @(IsIngesting ? "Ingerindo..." : "Iniciar ingestão")
        </button>

        @if (!File.Exists(FilePath) && !IsGenerating)
        {
            <p class="text-muted mt-2">Gere o arquivo de teste acima antes de iniciar a ingestão.</p>
        }

        @if (IsIngesting)
        {
            <div class="mt-3">
                <p>Linhas lidas: @LinesRead.ToString("N0")</p>
                <p>Registros inseridos: @RecordsInserted.ToString("N0")</p>
                <p class="text-muted">Tempo decorrido: @FormatElapsed(IngestionStopwatch)</p>
            </div>
        }

        @if (!IsIngesting && IngestionElapsedTime is not null)
        {
            <p class="text-success mt-3">
                Ingestão concluída em @IngestionElapsedTime.Value.TotalSeconds.ToString("N1")s
                (@RecordsInserted.ToString("N0") registros,
                @((RecordsInserted / Math.Max(IngestionElapsedTime.Value.TotalSeconds, 0.001)).ToString("N0")) registros/s)
            </p>
        }

        @if (IngestionErrorMessage is not null)
        {
            <p class="text-danger mt-3">@IngestionErrorMessage</p>
        }
    </div>
</div>
</div>

<div class="col-lg-4">
<div class="card h-100">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>3. Registros persistidos (dbo.IngestionData)</span>
        @if (TotalRecordCount is not null)
        {
            <span class="badge text-bg-info">@TotalRecordCount.Value.ToString("N0") registros</span>
        }
    </div>
    <div class="card-body">
        <p>
            Confirmação direta no banco de que os dados foram salvos, sem depender apenas dos
            contadores em memória exibidos acima.
        </p>

        <button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadPageAsync(CurrentPage)" disabled="@(IsLoadingPage || IsClearingTable)">
            @if (IsLoadingPage)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @(IsLoadingPage ? "Atualizando..." : "Atualizar")
        </button>
        <button class="btn btn-outline-danger btn-sm ms-2" @onclick="ClearTableAsync" disabled="@(IsLoadingPage || IsClearingTable)">
            @if (IsClearingTable)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @(IsClearingTable ? "Limpando..." : "Limpar tabela")
        </button>

        @if (TableErrorMessage is not null)
        {
            <p class="text-danger mt-2">@TableErrorMessage</p>
        }

        @if (TotalRecordCount is not null)
        {
            <div style="max-height: 220px; overflow: auto;">
            <table class="table table-sm table-bordered mt-3">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>RawValue</th>
                        <th>IngestedAtUtc</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in CurrentPageRecords)
                    {
                        <tr>
                            <td>@record.Id</td>
                            <td>@record.RawValue</td>
                            <td>@record.IngestedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadPageAsync(CurrentPage - 1)" disabled="@(IsLoadingPage || CurrentPage <= 1)">Anterior</button>
                <span>Página @CurrentPage de @TotalPages</span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadPageAsync(CurrentPage + 1)" disabled="@(IsLoadingPage || CurrentPage >= TotalPages)">Próxima</button>
            </div>
        }
    </div>
</div>
</div>
</div>
@code {
    private const string SimpleFileName = "ingestion-sample.txt";
    private const string SpedFileName = "ingestion-sample-sped.txt";
    private const int PreviewLineCount = 10;

    private RecordFormat SelectedFormat { get; set; } = RecordFormat.Simple;
    private List<string> PreviewLines { get; set; } = new();

    protected override void OnInitialized()
    {
        RefreshPreview();
    }

    private void SelectFormat(RecordFormat format)
    {
        SelectedFormat = format;
        RefreshPreview();
    }

    /// <summary>
    /// Builds a small in-memory sample (not the real generator) that mirrors exactly what
    /// <see cref="TestDataFileGenerator"/> would write for the selected format, so the user
    /// can see the layout before committing to generating millions of rows.
    /// </summary>
    private void RefreshPreview()
    {
        PreviewLines = SelectedFormat == RecordFormat.Simple
            ? BuildSimplePreview()
            : BuildSpedCompletoPreview();
    }

    private static List<string> BuildSimplePreview()
    {
        var lines = new List<string>(PreviewLineCount);
        for (var id = 1; id <= PreviewLineCount; id++)
        {
            lines.Add($"{id}|sample-payload-{id}");
        }

        return lines;
    }

    private static List<string> BuildSpedCompletoPreview()
    {
        var lines = new List<string>(PreviewLineCount)
        {
            "0000|1|01012024|31122024|EMPRESA TESTE LTDA|12345678000199|SP"
        };

        long entryNumber = 0;
        for (var detailLine = 1; lines.Count < PreviewLineCount - 1; detailLine++)
        {
            var isLancamentoHeader = (detailLine - 1) % 5 == 0;
            if (isLancamentoHeader)
            {
                entryNumber++;
                lines.Add($"I200|{detailLine}|20240115|LCTO{entryNumber}|1|N");
            }
            else
            {
                var debitCredit = detailLine % 2 == 0 ? 'C' : 'D';
                lines.Add($"I250|{detailLine}|1.01.01.00{detailLine % 10}|{debitCredit}|1500.00|HISTORICO PADRAO");
            }
        }

        lines.Add("9999|<totalLinhasDetalhe>");

        return lines;
    }

    private long RecordCount { get; set; } = 1_000_000;

    /// <summary>
    /// Parses the masked (thousand-separator) numeric input. Falling back to the previous
    /// value on invalid input avoids clearing the field just because the user is mid-typing.
    /// </summary>
    private void OnRecordCountChanged(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        var digitsOnly = new string(text.Where(char.IsDigit).ToArray());

        if (long.TryParse(digitsOnly, out var parsed) && parsed > 0)
        {
            RecordCount = parsed;
        }
    }
    private long GeneratedCount { get; set; }
    private bool IsGenerating { get; set; }
    private TimeSpan? ElapsedTime { get; set; }
    private string? ErrorMessage { get; set; }
    private readonly System.Diagnostics.Stopwatch GenerationStopwatch = new();
    private System.Threading.Timer? _generationUiTimer;
    private string FilePath => Path.Combine(
        Environment.ContentRootPath,
        "App_Data",
        SelectedFormat == RecordFormat.Simple ? SimpleFileName : SpedFileName);

    /// <summary>
    /// URL of the "/download/{fileName}" minimal API endpoint (see Program.cs), used so the
    /// browser downloads the generated file straight to the user's machine - unlike opening
    /// the folder on the server, this works regardless of where the app is hosted.
    /// </summary>
    private string DownloadUrl => $"/download/{Uri.EscapeDataString(SelectedFormat == RecordFormat.Simple ? SimpleFileName : SpedFileName)}";

    /// <summary>
    /// Formats an in-progress <see cref="System.Diagnostics.Stopwatch"/> as mm:ss.f. Using
    /// Stopwatch (monotonic, high-resolution) instead of DateTime.Now/system clock avoids
    /// any drift from clock adjustments and gives the user live feedback without needing to
    /// watch a separate Windows clock.
    /// </summary>
    private static string FormatElapsed(System.Diagnostics.Stopwatch stopwatch)
        => stopwatch.Elapsed.ToString(@"mm\:ss\.f");

    private async Task GenerateAsync()
    {
        if (RecordCount <= 0)
        {
            ErrorMessage = "Informe uma quantidade de registros maior que zero.";
            return;
        }

        IsGenerating = true;
        GeneratedCount = 0;
        ElapsedTime = null;
        ErrorMessage = null;

        var progress = new Progress<long>(count =>
        {
            GeneratedCount = count;
            InvokeAsync(StateHasChanged);
        });

        GenerationStopwatch.Restart();
        // Ticks the UI every 100ms so the elapsed-time counter updates live, independent of
        // progress reports (which only fire every ProgressReportInterval rows).
        _generationUiTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 100, 100);

        try
        {
            await TestDataFileGenerator.GenerateAsync(FilePath, RecordCount, SelectedFormat, progress);
            ElapsedTime = GenerationStopwatch.Elapsed;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate test data file with {RecordCount} records", RecordCount);
            ErrorMessage = $"Falha ao gerar o arquivo: {ex.Message}";
        }
        finally
        {
            GenerationStopwatch.Stop();
            _generationUiTimer?.Dispose();
            _generationUiTimer = null;
            IsGenerating = false;
        }
    }

    /// <summary>
    /// Opens Windows Explorer with the generated file pre-selected. This is a Blazor Server
    /// app: the server process runs on the same machine as the user (LocalDB scenario), so
    /// launching a local process from here opens the folder on the user's own desktop.
    /// </summary>
    private void OpenFileFolder()
    {
        try
        {
            if (!File.Exists(FilePath))
            {
                ErrorMessage = "Arquivo não encontrado para abrir a pasta.";
                return;
            }

            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
            {
                FileName = "explorer.exe",
                Arguments = $"/select,\"{FilePath}\"",
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open folder for file {FilePath}", FilePath);
            ErrorMessage = $"Falha ao abrir a pasta: {ex.Message}";
        }
    }

    private bool IsIngesting { get; set; }
    private long LinesRead { get; set; }
    private long RecordsInserted { get; set; }
    private TimeSpan? IngestionElapsedTime { get; set; }
    private string? IngestionErrorMessage { get; set; }
    private readonly System.Diagnostics.Stopwatch IngestionStopwatch = new();
    private System.Threading.Timer? _ingestionUiTimer;

    private async Task IngestAsync()
    {
        if (!File.Exists(FilePath))
        {
            IngestionErrorMessage = "Arquivo de teste não encontrado. Gere a massa de dados primeiro.";
            return;
        }

        IsIngesting = true;
        LinesRead = 0;
        RecordsInserted = 0;
        IngestionElapsedTime = null;
        IngestionErrorMessage = null;

        // IngestionPipeline is registered as Transient: each run gets a fresh Channel.
        var pipeline = ServiceProvider.GetRequiredService<IngestionPipeline>();

        var readProgress = new Progress<long>(count =>
        {
            LinesRead = count;
            InvokeAsync(StateHasChanged);
        });

        var insertProgress = new Progress<long>(count =>
        {
            RecordsInserted = count;
            InvokeAsync(StateHasChanged);
        });

        IngestionStopwatch.Restart();
        _ingestionUiTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 100, 100);

        try
        {
            await Task.WhenAll(
                pipeline.ProduceFromFileAsync(FilePath, SelectedFormat, readProgress),
                pipeline.ConsumeAsync(insertProgress));

            IngestionElapsedTime = IngestionStopwatch.Elapsed;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ingestion run failed for file {FilePath}", FilePath);
            IngestionErrorMessage = $"Falha na ingestão: {ex.Message}";
        }
        finally
        {
            IngestionStopwatch.Stop();
            _ingestionUiTimer?.Dispose();
            _ingestionUiTimer = null;
            IsIngesting = false;
        }

        // Reload the paginated table so the user can immediately see, straight from the
        // database, that the just-ingested rows are really there.
        await LoadPageAsync(1);
    }

    private const int PageSize = 20;

    private int CurrentPage { get; set; } = 1;
    private long? TotalRecordCount { get; set; }
    private List<IngestionRecord> CurrentPageRecords { get; set; } = new();
    private bool IsLoadingPage { get; set; }
    private bool IsClearingTable { get; set; }
    private string? TableErrorMessage { get; set; }

    private int TotalPages => TotalRecordCount is null or 0
        ? 1
        : (int)Math.Ceiling(TotalRecordCount.Value / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int pageNumber)
    {
        if (pageNumber < 1)
        {
            return;
        }

        IsLoadingPage = true;
        TableErrorMessage = null;

        try
        {
            TotalRecordCount = await IngestionDataReader.GetTotalCountAsync(CancellationToken.None);
            CurrentPage = Math.Min(pageNumber, TotalPages);
            CurrentPageRecords = (await IngestionDataReader.GetPageAsync(CurrentPage, PageSize, CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load ingestion data page {PageNumber}", pageNumber);
            TableErrorMessage = $"Falha ao consultar os registros: {ex.Message}";
        }
        finally
        {
            IsLoadingPage = false;
        }
    }

    private async Task ClearTableAsync()
    {
        IsClearingTable = true;
        TableErrorMessage = null;

        try
        {
            await IngestionDataReader.TruncateAsync(CancellationToken.None);
            await LoadPageAsync(1);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to clear dbo.IngestionData");
            TableErrorMessage = $"Falha ao limpar a tabela: {ex.Message}";
        }
        finally
        {
            IsClearingTable = false;
        }
    }

    public void Dispose()
    {
        _generationUiTimer?.Dispose();
        _ingestionUiTimer?.Dispose();
    }
}
